{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Wedding/Wedding.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/Wedding/Wedding.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/Wedding/Wedding.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "npm: build",
            "type": "npm",
            "script": "build",
            "path": "src/",
            "problemMatcher": "$tsc"
        },
        {
            "label": "npm: watch",
            "type": "npm",
            "script": "watch",
            "path": "src/",
            "isBackground": true,
            "problemMatcher": "$tsc-watch"
        }
    ]
}